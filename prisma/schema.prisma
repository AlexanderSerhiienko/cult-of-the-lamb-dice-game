generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  USER
  ADMIN
}

enum MatchMode {
  BOT
  ONLINE
}

enum MatchOutcome {
  WIN
  LOSE
  DRAW
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  role          AppRole       @default(USER)
  accounts      Account[]
  sessions      Session[]
  matchResults  MatchResult[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model MatchResult {
  id              String       @id @default(cuid())
  externalMatchId String
  mode            MatchMode
  outcome         MatchOutcome
  playerScore     Int
  opponentScore   Int
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([mode, createdAt])
  @@unique([userId, externalMatchId])
}
